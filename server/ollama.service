[Unit]
Description=Ollama (models on local SSD)
After=network-online.target mnt-disks-ssd.mount
RequiresMountsFor=/mnt/disks/ssd

[Service]
ExecStart=/mnt/disks/ssd/ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/mnt/disks/ssd/ollama/models
Environment=OLLAMA_KEEP_ALIVE=24h
User=ollama
Group=ollama
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
